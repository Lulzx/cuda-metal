integrator = md
dt = 0.002
nsteps = 500
nstcalcenergy = 5000
nstenergy = 0
nstlog = 0
nstxout-compressed = 0
nstcomm = 100
cutoff-scheme = Verlet
nstlist = 10
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
pme-order = 4
fourier-nx = 84
fourier-ny = 84
fourier-nz = 84
constraints = h-bonds
pbc = xyz
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 300
pcoupl = no
gen-vel = no
