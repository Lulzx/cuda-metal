@@ -200,6 +200,23 @@ bool init_cuda_driver()
         }
     }
     pfn_cuGetProcAddress = (PFN_cuGetProcAddress)dlsym(hCudaDriver, "cuGetProcAddress");
+#elif defined(__APPLE__)
+    // CuMetal provides the CUDA driver surface on Apple Silicon. Its libcuda.dylib
+    // alias is optional (CUMETAL_ENABLE_BINARY_SHIM), so fall back to the library's
+    // own name; both export cuGetProcAddress.
+    static void* hCudaDriver = dlopen("libcuda.dylib", RTLD_NOW);
+    if (hCudaDriver == NULL) {
+        hCudaDriver = dlopen("libcumetal.dylib", RTLD_NOW);
+        if (hCudaDriver == NULL) {
+            fprintf(
+                stderr,
+                "Warp CUDA warning: Could not find or load the CuMetal CUDA driver (libcuda.dylib / "
+                "libcumetal.dylib). GPU execution will not be available.\n"
+            );
+            return false;
+        }
+    }
+    pfn_cuGetProcAddress = (PFN_cuGetProcAddress)dlsym(hCudaDriver, "cuGetProcAddress");
 #endif
 
     if (!pfn_cuGetProcAddress) {
