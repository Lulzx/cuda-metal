.version 7.1
.target sm_80
.address_size 64
.visible .entry invariant_loop(.param .u64 input, .param .u64 output, .param .u32 count) {
.reg .b64 %rd<6>;
.reg .b32 %r<8>;
.reg .pred %p1;
ld.param.u64 %rd0, [input];
ld.param.u64 %rd1, [output];
ld.param.u32 %r0, [count];
mov.u32 %r3, %ctaid.x;
mov.u32 %r4, %ntid.x;
mov.u32 %r5, %tid.x;
mad.lo.u32 %r3, %r3, %r4, %r5;
setp.ge.u32 %p1, %r3, %r0;
@%p1 bra DONE;
mul.wide.u32 %rd2, %r3, 4;
add.u64 %rd3, %rd0, %rd2;
add.u64 %rd4, %rd1, %rd2;
ld.global.u32 %r1, [%rd3];
and.b32 %r1, %r1, 31;
mov.u32 %r2, 0;
LOOP:
add.u32 %r2, %r2, 1;
setp.lt.u32 %p1, %r2, %r1;
@%p1 bra LOOP;
st.global.u32 [%rd4], %r2;
DONE:
ret;
}
