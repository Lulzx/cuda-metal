.version 8.0
.target sm_80
.address_size 64
.func noop() { ret; }
.visible .entry integer_probe(.param .u64 input, .param .u64 output, .param .u32 count) {
.reg .b64 %rd<5>;
.reg .b32 %r<9>;
.reg .pred %p<4>;
ld.param.u64 %rd0, [input];
ld.param.u64 %rd1, [output];
ld.param.u32 %r2, [count];
mov.u32 %r3, %ctaid.x;
mov.u32 %r4, %ntid.x;
mov.u32 %r5, %tid.x;
mad.lo.u32 %r0, %r3, %r4, %r5;
setp.ge.u32 %p0, %r0, %r2;
@%p0 bra DONE;
mul.wide.u32 %rd2, %r0, 4;
add.u64 %rd3, %rd0, %rd2;
add.u64 %rd4, %rd1, %rd2;
mov.u32 %r8, 0;
mov.pred %p3, 1;
LOOP:
ld.global.u32 %r6, [%rd3];
add.u32 %r8, %r8, 1;
setp.eq.u32 %p1, %r8, 1;
mov.pred %p2, 0;
@!%p1 bra JOIN;
call.uni noop, ();
mov.pred %p2, %p3;
mov.b32 %r6, %r7;
JOIN:
mov.b32 %r7, %r6;
@%p2 bra LOOP;
st.global.u32 [%rd4], %r7;
DONE:
ret;
}
