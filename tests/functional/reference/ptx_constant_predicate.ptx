.version 8.0
.target sm_80
.address_size 64
.visible .entry constant_guard(.param .u64 input, .param .u64 output, .param .u32 count) {
.reg .pred %p<4>;
.reg .b32 %r<8>;
.reg .b64 %rd<5>;
ld.param.u64 %rd0, [input];
ld.param.u64 %rd1, [output];
ld.param.u32 %r2, [count];
mov.u32 %r3, %ctaid.x;
mov.u32 %r4, %ntid.x;
mov.u32 %r5, %tid.x;
mad.lo.u32 %r0, %r3, %r4, %r5;
setp.ge.u32 %p3, %r0, %r2;
@%p3 bra DONE;
mul.wide.u32 %rd2, %r0, 4;
add.u64 %rd3, %rd1, %rd2;
setp.eq.u32 %p0, %r0, 0;
mov.pred %p1, -1;
@%p0 bra JOIN;
ld.global.u32 %r1, [%rd0];
mov.pred %p1, 0;
JOIN:
not.pred %p2, %p1;
@%p2 bra USE;
st.global.u32 [%rd3], 99;
ret;
USE:
st.global.u32 [%rd3], %r1;
DONE:
ret;
}
