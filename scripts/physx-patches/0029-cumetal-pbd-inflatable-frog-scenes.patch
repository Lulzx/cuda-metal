+static void shapeFrog(PxArray<PxVec3>& vertices)
+{
+	for (PxU32 i = 0; i < vertices.size(); ++i)
+	{
+		PxVec3& p = vertices[i];
+		const PxReal nx = p.x * 0.5f;
+		const PxReal ny = p.y * 0.5f;
+		const PxReal upper = PxMax(ny, 0.0f);
+		const PxReal lower = PxMax(-ny, 0.0f);
+		const PxReal side = PxAbs(nx);
+
+		// A closed, sphere-topology frog: broad head, compact torso, large
+		// rear haunches/feet, and two raised eye lobes.
+		p.x *= 0.92f + 0.34f * upper + 0.52f * lower;
+		p.y = p.y * (0.72f + 0.08f * upper) + 0.45f;
+		p.z *= 0.62f + 0.12f * upper;
+		p.x += (nx < 0.0f ? -1.0f : 1.0f) * lower * lower * 0.78f;
+
+		const PxReal eye = PxMax(upper - 0.18f, 0.0f) *
+			PxMax(side - 0.22f, 0.0f) * 2.8f;
+		p.y += eye;
+		p.z += eye * 0.55f;
+	}
+}
