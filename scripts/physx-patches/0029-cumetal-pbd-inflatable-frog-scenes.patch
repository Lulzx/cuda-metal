+static bool validateInflatable()
+{
+	const PxU32 numParticles = gUserClothBuffer->getNbActiveParticles();
+	PxVec4* positions = Ext::PxCudaHelpersExt::allocPinnedHostBuffer<PxVec4>(
+		*gCudaContextManager, numParticles);
+	PxVec4* velocities = Ext::PxCudaHelpersExt::allocPinnedHostBuffer<PxVec4>(
+		*gCudaContextManager, numParticles);
+	Ext::PxCudaHelpersExt::copyDToH(*gCudaContextManager, positions,
+		gUserClothBuffer->getPositionInvMasses(), numParticles);
+	Ext::PxCudaHelpersExt::copyDToH(*gCudaContextManager, velocities,
+		gUserClothBuffer->getVelocities(), numParticles);
+
+	PxVec3 centroid(0.0f);
+	PxReal maxSpeed = 0.0f;
+	bool finite = true;
+	for (PxU32 i = 0; i < numParticles; ++i)
+	{
+		finite = finite && positions[i].isFinite() && velocities[i].isFinite();
+		centroid += PxVec3(positions[i].x, positions[i].y, positions[i].z);
+		maxSpeed = PxMax(maxSpeed,
+			PxVec3(velocities[i].x, velocities[i].y, velocities[i].z).magnitude());
+	}
+	centroid /= PxReal(numParticles);
+
+	PxReal averageRadius = 0.0f;
+	for (PxU32 i = 0; i < numParticles; ++i)
+		averageRadius +=
+			(PxVec3(positions[i].x, positions[i].y, positions[i].z) - centroid).magnitude();
+	averageRadius /= PxReal(numParticles);
+
+	PxBounds3 bounds = PxBounds3::empty();
+	for (PxU32 i = 0; i < numParticles; ++i)
+		bounds.include(PxVec3(positions[i].x, positions[i].y, positions[i].z));
+	const PxVec3 dimensions = bounds.getDimensions();
+	Ext::PxCudaHelpersExt::freePinnedHostBuffer(*gCudaContextManager, positions);
+	Ext::PxCudaHelpersExt::freePinnedHostBuffer(*gCudaContextManager, velocities);
+	const bool passed = finite && centroid.y < 0.45f && maxSpeed > 0.01f &&
+		(gFrogScene ? dimensions.x > dimensions.z * 1.6f : averageRadius > 2.01f);
+	printf("CUMETAL_PHYSX_%s %s particles=%u average_radius=%.9g "
+		"centroid_y=%.9g max_speed=%.9g dimensions=[%.6g,%.6g,%.6g]\n",
+		gFrogScene ? "FROG" : "INFLATABLE", passed ? "PASS" : "FAIL",
+		numParticles, averageRadius, centroid.y, maxSpeed,
+		double(dimensions.x), double(dimensions.y), double(dimensions.z));
+	return passed;
+}
