diff --git a/physx/snippets/snippetpbdcloth/CuMetalCloth.cu b/physx/snippets/snippetpbdcloth/CuMetalCloth.cu
new file mode 100644
--- /dev/null
+++ b/physx/snippets/snippetpbdcloth/CuMetalCloth.cu
@@ -0,0 +1,62 @@
+// A small source-first CUDA collision driver used by the CuMetal drape
+// recreation. PhysX still owns integration, spring solving, self-collision,
+// and aerodynamics; this kernel only supplies the analytic sphere and ground
+// constraints, because particle/rigid-body narrowphase is not part of the
+// CuMetal PBD kernel closure.
+
+extern "C" __global__ void cumetalClothCollide(
+	float4* velocities, const float4* positions, unsigned int count,
+	float centerX, float centerY, float centerZ, float radius,
+	float groundY, float invDt, float friction)
+{
+	const unsigned int index = blockIdx.x * blockDim.x + threadIdx.x;
+	if (index >= count)
+		return;
+
+	const float4 position = positions[index];
+	float4 velocity = velocities[index];
+
+	// Analytic sphere: cancel the inward normal velocity and add just enough
+	// separation speed to resolve the current penetration over one step.
+	const float dx = position.x - centerX;
+	const float dy = position.y - centerY;
+	const float dz = position.z - centerZ;
+	const float distanceSquared = dx * dx + dy * dy + dz * dz;
+	if (distanceSquared > 1.0e-12f && distanceSquared < radius * radius)
+	{
+		const float inverseDistance = rsqrtf(distanceSquared);
+		const float nx = dx * inverseDistance;
+		const float ny = dy * inverseDistance;
+		const float nz = dz * inverseDistance;
+		const float depth = radius - 1.0f / inverseDistance;
+
+		const float normalSpeed = velocity.x * nx + velocity.y * ny + velocity.z * nz;
+		const float targetSpeed = depth * invDt * 0.8f;
+		if (normalSpeed < targetSpeed)
+		{
+			const float correction = targetSpeed - normalSpeed;
+			velocity.x += nx * correction;
+			velocity.y += ny * correction;
+			velocity.z += nz * correction;
+		}
+
+		// Coulomb-style tangential damping keeps the sheet from sliding off.
+		const float tangentSpeed = velocity.x * nx + velocity.y * ny + velocity.z * nz;
+		velocity.x -= friction * (velocity.x - nx * tangentSpeed);
+		velocity.y -= friction * (velocity.y - ny * tangentSpeed);
+		velocity.z -= friction * (velocity.z - nz * tangentSpeed);
+	}
+
+	// Ground plane.
+	const float groundDepth = groundY - position.y;
+	if (groundDepth > 0.0f)
+	{
+		const float targetSpeed = groundDepth * invDt * 0.8f;
+		if (velocity.y < targetSpeed)
+			velocity.y = targetSpeed;
+		velocity.x -= friction * velocity.x;
+		velocity.z -= friction * velocity.z;
+	}
+
+	velocities[index] = velocity;
+}
