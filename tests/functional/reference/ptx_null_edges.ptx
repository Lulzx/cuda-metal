.version 8.0
.target sm_80
.address_size 64
.visible .entry null_edge(.param .u64 input, .param .u64 output, .param .u32 count) {
.reg .pred %p<4>;
.reg .b32 %r<5>;
.reg .b64 %rd<8>;
ld.param.u64 %rd0, [input];
ld.param.u64 %rd1, [output];
ld.param.u32 %r2, [count];
mov.u32 %r0, %ctaid.x;
mov.u32 %r3, %ntid.x;
mov.u32 %r4, %tid.x;
mad.lo.u32 %r0, %r0, %r3, %r4;
setp.ge.u32 %p2, %r0, %r2;
@%p2 bra DONE;
setp.eq.u32 %p0, %r0, 0;
mov.u64 %rd2, 0;
@%p0 bra JOIN;
mov.u64 %rd2, %rd0;
JOIN:
setp.eq.u64 %p1, %rd2, 0;
mov.u32 %r1, 99;
@%p1 bra END;
ld.global.u32 %r1, [%rd2];
END:
mul.wide.u32 %rd3, %r0, 4;
add.u64 %rd4, %rd1, %rd3;
st.global.u32 [%rd4], %r1;
DONE:
ret;
}
