+static bool initCuMetalPressureKernel()
+{
+	const char* kernelDirectory = getenv("CUMETAL_PHYSX_KERNEL_DIR");
+	if (!kernelDirectory || !gCudaContextManager->tryAcquireContext())
+		return false;
+
+	char path[1024];
+	Pxsnprintf(path, sizeof(path), "%s/cumetalInflatablePressure.metallib", kernelDirectory);
+	PxCudaContext* context = gCudaContextManager->getCudaContext();
+	PxCUresult result = context->moduleLoadDataEx(&gPressureModule, path, 0, NULL, NULL);
+	if (result.value == 0)
+		result = context->moduleGetFunction(&gPressureKernel, gPressureModule, "cumetalInflatablePressure");
+	if (result.value == 0)
+		result = context->streamCreate(&gPressureStream, 0);
+	gCudaContextManager->releaseContext();
+
+	if (result.value != 0)
+	{
+		printf("CUMETAL_PHYSX_INFLATABLE pressure kernel load failed (%u): %s\n",
+			PxU32(result), path);
+		gPressureKernel = NULL;
+		return false;
+	}
+	return true;
+}
+
+static bool applyCuMetalPressure()
+{
+	if (!gPressureKernel)
+		return false;
+
+	PxCudaContext* context = gCudaContextManager->getCudaContext();
+	PxVec4* velocities = gUserClothBuffer->getVelocities();
+	const PxVec4* positions = gUserClothBuffer->getPositionInvMasses();
+	const PxU32 count = gUserClothBuffer->getNbActiveParticles();
+	const PxReal elapsed = PxReal(gFrameIndex) / 60.0f;
+	const PxReal centerY = -0.5f * 9.81f * elapsed * elapsed;
+	const PxReal radialVelocityStep = gFrogScene ? 0.025f : 0.18f;
+	PxCudaKernelParam params[] =
+	{
+		PX_CUDA_KERNEL_PARAM(velocities),
+		PX_CUDA_KERNEL_PARAM(positions),
+		PX_CUDA_KERNEL_PARAM(count),
+		PX_CUDA_KERNEL_PARAM(centerY),
+		PX_CUDA_KERNEL_PARAM(radialVelocityStep)
+	};
+	const PxU32 blockSize = 256;
+	const PxCUresult result = context->launchKernel(
+		gPressureKernel, (count + blockSize - 1) / blockSize, 1, 1,
+		blockSize, 1, 1, 0, gPressureStream, params, sizeof(params), NULL,
+		__FILE__, __LINE__);
+	if (result.value == 0)
+		context->streamSynchronize(gPressureStream);
+	return result.value == 0;
+}
