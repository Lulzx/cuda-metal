integrator = md
dt = 0.001
nsteps = 2000
nstcalcenergy = 100
nstenergy = 100
nstlog = 100
nstxout-compressed = 0
nstcomm = 100
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.0
