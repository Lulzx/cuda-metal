integrator = md
dt = 0.002
nsteps = 500
nstcalcenergy = 500
nstenergy = 0
nstlog = 0
nstxout-compressed = 0
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
pme-order = 4
fourier-nx = 192
fourier-ny = 192
fourier-nz = 192
constraints = h-bonds
pbc = xyz
tcoupl = no
pcoupl = no
gen-vel = no
