.version 8.0
.target sm_80
.address_size 64
.visible .entry loop_invariant_expression(
    .param .u64 input, .param .u64 output, .param .u32 count) {
.reg .b64 %rd<8>;
.reg .b32 %r<10>;
.reg .pred %p<4>;
ld.param.u64 %rd0, [input];
ld.param.u64 %rd1, [output];
ld.param.u32 %r2, [count];
mov.u32 %r3, %ctaid.x;
mov.u32 %r4, %ntid.x;
mov.u32 %r5, %tid.x;
mad.lo.u32 %r0, %r3, %r4, %r5;
setp.ge.u32 %p0, %r0, %r2;
@%p0 bra DONE;
mul.wide.u32 %rd2, %r0, 8;
add.u64 %rd3, %rd0, %rd2;
mul.wide.u32 %rd4, %r0, 4;
add.u64 %rd4, %rd1, %rd4;
ld.global.u32 %r6, [%rd3];
ld.global.u32 %r7, [%rd3+4];
mov.u32 %r8, 0;
cvt.u64.u32 %rd6, %r6;
LOOP:
cvt.u64.u32 %rd7, %r8;
setp.ge.u64 %p1, %rd7, %rd6;
@%p1 bra JOIN;
mov.u32 %r1, %r7;
JOIN:
cvt.u64.u32 %rd5, %r6;
setp.ge.u64 %p2, %rd7, %rd5;
@%p2 bra DONE;
st.global.u32 [%rd4], %r1;
add.u32 %r8, %r8, 1;
bra LOOP;
DONE:
ret;
}
