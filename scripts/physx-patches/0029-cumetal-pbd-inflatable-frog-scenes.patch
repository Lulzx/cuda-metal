+		*gCudaContextManager, count);
+	Ext::PxCudaHelpersExt::copyDToH(*gCudaContextManager, positions,
+		gUserClothBuffer->getPositionInvMasses(), count);
+	fprintf(gCaptureFile, "%s[", gFirstCaptureFrame ? "" : ",");
+	for (PxU32 i = 0; i < count; ++i)
+		fprintf(gCaptureFile, "%s[%.7g,%.7g,%.7g]", i ? "," : "",
+			double(positions[i].x), double(positions[i].y), double(positions[i].z));
+	fprintf(gCaptureFile, "]");
+	gFirstCaptureFrame = false;
+	Ext::PxCudaHelpersExt::freePinnedHostBuffer(*gCudaContextManager, positions);
+}
