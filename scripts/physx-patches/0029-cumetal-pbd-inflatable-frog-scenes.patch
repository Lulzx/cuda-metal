@@ -0,0 +1,26 @@
+// A small source-first CUDA pressure driver used by the CuMetal recreation.
+// PhysX still owns integration, collision, and buffer synchronization.
+
+extern "C" __global__ void cumetalInflatablePressure(
+	float4* velocities, const float4* positions, unsigned int count,
+	float centerY, float acceleration)
+{
+	const unsigned int index = blockIdx.x * blockDim.x + threadIdx.x;
+	if (index >= count)
+		return;
+
+	const float4 position = positions[index];
+	const float x = position.x;
+	const float y = position.y - centerY;
+	const float z = position.z;
+	const float lengthSquared = x * x + y * y + z * z;
+	if (lengthSquared <= 1.0e-12f)
+		return;
+
+	const float inverseLength = rsqrtf(lengthSquared);
+	float4 velocity = velocities[index];
+	velocity.x += x * inverseLength * acceleration;
+	velocity.y += y * inverseLength * acceleration;
+	velocity.z += z * inverseLength * acceleration;
+	velocities[index] = velocity;
+}
