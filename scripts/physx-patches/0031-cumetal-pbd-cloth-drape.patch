+// The drape has no pinned reference, so it is gated on contact invariants:
+// the sheet must not sink into the sphere, must wrap past its equator, and
+// must have settled by the end of the capture window.
+static bool validateDrape()
+{
+	const PxU32 numParticles = gNumX * gNumZ;
+	PxVec4* positions = Ext::PxCudaHelpersExt::allocPinnedHostBuffer<PxVec4>(
+		*gCudaContextManager, numParticles);
+	PxVec4* velocities = Ext::PxCudaHelpersExt::allocPinnedHostBuffer<PxVec4>(
+		*gCudaContextManager, numParticles);
+	Ext::PxCudaHelpersExt::copyDToH(*gCudaContextManager, positions,
+		gClothBuffer->getPositionInvMasses(), numParticles);
+	Ext::PxCudaHelpersExt::copyDToH(*gCudaContextManager, velocities,
+		gClothBuffer->getVelocities(), numParticles);
+
+	bool finite = true;
+	PxReal minRadius = PX_MAX_F32;
+	PxReal maxSpeed = 0.0f;
+	PxReal totalSpeed = 0.0f;
+	PxReal minY = PX_MAX_F32;
+	PxReal maxY = -PX_MAX_F32;
+	PxU32 contactCount = 0;
+	for (PxU32 i = 0; i < numParticles; ++i)
+	{
+		const PxVec4& position = positions[i];
+		const PxVec4& velocity = velocities[i];
+		finite = finite && position.isFinite() && velocity.isFinite();
+		const PxReal speed = PxVec3(velocity.x, velocity.y, velocity.z).magnitude();
+		maxSpeed = PxMax(maxSpeed, speed);
+		totalSpeed += speed;
+		const PxVec3 current(position.x, position.y, position.z);
+		const PxReal radius = (current - gDrapeSphereCenter).magnitude();
+		minRadius = PxMin(minRadius, radius);
+		minY = PxMin(minY, current.y);
+		maxY = PxMax(maxY, current.y);
+		if (radius < gDrapeSphereRadius + 2.0f * gParticleSpacing)
+			++contactCount;
+	}
+
+	Ext::PxCudaHelpersExt::freePinnedHostBuffer(*gCudaContextManager, positions);
+	Ext::PxCudaHelpersExt::freePinnedHostBuffer(*gCudaContextManager, velocities);
+
+	// A sheet resting on the sphere touches it, hangs below its equator, and
+	// does not tunnel through its surface.
+	const PxReal penetration = PxMax(0.0f, gDrapeSphereRadius - minRadius);
+	const bool touching = contactCount >= 16;
+	const bool wrapped = minY < gDrapeSphereCenter.y;
+	// A single wedged particle can hold a large velocity while the sheet is
+	// visibly at rest, so rest is judged on the mean, not the maximum.
+	const PxReal meanSpeed = totalSpeed / PxReal(numParticles);
+	const bool settled = meanSpeed < 1.0f;
+	const bool passed = finite && touching && wrapped && settled &&
+		penetration <= 2.0f * gParticleSpacing;
+	printf("CUMETAL_PHYSX_DRAPE %s particles=%u penetration=%.9g contacts=%u "
+		"mean_speed=%.9g max_speed=%.9g y=[%.6g,%.6g] sphere_top=%.6g\n",
+		passed ? "PASS" : "FAIL", numParticles, penetration, contactCount,
+		meanSpeed, maxSpeed, minY, maxY,
+		double(gDrapeSphereCenter.y + gDrapeSphereRadius));
+	return passed;
+}
