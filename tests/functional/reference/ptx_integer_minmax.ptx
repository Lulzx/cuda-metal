
.version 7.1
.target sm_80
.address_size 64
.visible .entry integer_minmax(.param .u64 input, .param .u64 output, .param .u32 count) {
.reg .b64 %rd<12>;
.reg .b32 %r<6>;
.reg .pred %p1;
ld.param.u64 %rd1, [input];
ld.param.u64 %rd2, [output];
ld.param.u32 %r1, [count];
mov.u32 %r2, %ctaid.x;
mov.u32 %r3, %ntid.x;
mov.u32 %r4, %tid.x;
mad.lo.u32 %r2, %r2, %r3, %r4;
setp.ge.u32 %p1, %r2, %r1;
@%p1 bra DONE;
mul.wide.u32 %rd10, %r2, 8;
mul.wide.u32 %rd11, %r2, 32;
add.u64 %rd3, %rd1, %rd10;
add.u64 %rd4, %rd2, %rd11;
ld.global.u64 %rd5, [%rd3];
min.u64 %rd6, %rd5, 64;
max.u64 %rd7, 64, %rd5;
min.s64 %rd8, %rd5, -1;
max.s64 %rd9, -1, %rd5;
st.global.u64 [%rd4], %rd6;
st.global.u64 [%rd4+8], %rd7;
st.global.u64 [%rd4+16], %rd8;
st.global.u64 [%rd4+24], %rd9;
DONE:
ret;
}
