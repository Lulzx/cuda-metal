+// Particle/rigid-body narrowphase is not part of the CuMetal PBD kernel
+// closure, so the drape's obstacle is supplied by a source-first CUDA kernel
+// compiled by cumetalc, in the same way the inflatable supplies its pressure.
+static bool initCuMetalCollideKernel()
+{
+	const char* kernelDirectory = getenv("CUMETAL_PHYSX_KERNEL_DIR");
+	if (!kernelDirectory || !gCudaContextManager->tryAcquireContext())
+		return false;
+
+	char path[1024];
+	Pxsnprintf(path, sizeof(path), "%s/cumetalClothCollide.metallib", kernelDirectory);
+	PxCudaContext* context = gCudaContextManager->getCudaContext();
+	PxCUresult result = context->moduleLoadDataEx(&gCollideModule, path, 0, NULL, NULL);
+	if (result.value == 0)
+		result = context->moduleGetFunction(&gCollideKernel, gCollideModule, "cumetalClothCollide");
+	if (result.value == 0)
+		result = context->streamCreate(&gCollideStream, 0);
+	gCudaContextManager->releaseContext();
+
+	if (result.value != 0)
+	{
+		printf("CUMETAL_PHYSX_DRAPE collide kernel load failed (%u): %s\n",
+			PxU32(result), path);
+		gCollideKernel = NULL;
+		return false;
+	}
+	return true;
+}
+
+static bool applyCuMetalCollide(PxReal dt)
+{
+	if (!gCollideKernel)
+		return false;
+
+	PxCudaContext* context = gCudaContextManager->getCudaContext();
+	PxVec4* velocities = gClothBuffer->getVelocities();
+	const PxVec4* positions = gClothBuffer->getPositionInvMasses();
+	const PxU32 count = gClothBuffer->getNbActiveParticles();
+	const PxReal centerX = gDrapeSphereCenter.x;
+	const PxReal centerY = gDrapeSphereCenter.y;
+	const PxReal centerZ = gDrapeSphereCenter.z;
+	const PxReal radius = gDrapeSphereRadius + gParticleSpacing;
+	const PxReal groundY = 0.0f;
+	const PxReal invDt = 1.0f / dt;
+	const PxReal friction = 0.25f;
+	PxCudaKernelParam params[] =
+	{
+		PX_CUDA_KERNEL_PARAM(velocities),
+		PX_CUDA_KERNEL_PARAM(positions),
+		PX_CUDA_KERNEL_PARAM(count),
+		PX_CUDA_KERNEL_PARAM(centerX),
+		PX_CUDA_KERNEL_PARAM(centerY),
+		PX_CUDA_KERNEL_PARAM(centerZ),
+		PX_CUDA_KERNEL_PARAM(radius),
+		PX_CUDA_KERNEL_PARAM(groundY),
+		PX_CUDA_KERNEL_PARAM(invDt),
+		PX_CUDA_KERNEL_PARAM(friction)
+	};
+	const PxU32 blockSize = 256;
+	const PxCUresult result = context->launchKernel(
+		gCollideKernel, (count + blockSize - 1) / blockSize, 1, 1,
+		blockSize, 1, 1, 0, gCollideStream, params, sizeof(params), NULL,
+		__FILE__, __LINE__);
+	if (result.value == 0)
+		context->streamSynchronize(gCollideStream);
+	// Without this the next simulate() re-uploads the stale host-side
+	// velocities and the kernel's work is silently discarded.
+	gClothBuffer->raiseFlags(PxParticleBufferFlag::eUPDATE_VELOCITY);
+	return result.value == 0;
+}
