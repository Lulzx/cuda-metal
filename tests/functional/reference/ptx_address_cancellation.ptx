.version 8.8
.target sm_89
.address_size 64

.visible .entry cancellation_probe(
    .param .u64 .ptr .global input,
    .param .u64 .ptr .global output,
    .param .u32 count
) {
    .local .align 8 .b8 scratch[64];
    .reg .pred %p<4>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<20>;

    ld.param.u64 %rd0, [input];
    ld.param.u64 %rd1, [output];
    ld.param.u32 %r0, [count];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r1, %r2, %r3, %r1;
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra done;
    mul.wide.u32 %rd2, %r1, 16;
    add.u64 %rd3, %rd0, %rd2;
    ld.global.u64 %rd4, [%rd3];
    ld.global.u64 %rd5, [%rd3+8];
    mov.u64 %rd6, scratch;
    add.u64 %rd7, %rd6, %rd4;
    mov.u64 %rd8, 1;
    sub.s64 %rd9, %rd8, %rd7;
    sub.s64 %rd10, %rd9, %rd5;
    add.s64 %rd11, %rd6, %rd10;
    add.s64 %rd12, %rd11, 30;
    mul.wide.u32 %rd13, %r1, 8;
    add.u64 %rd14, %rd1, %rd13;
    st.global.u64 [%rd14], %rd12;
done:
    ret;
}
